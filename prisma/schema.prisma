generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IncomeType {
  GRANT
  PRIVATE_SERVICE
  DONATION
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  RESTRUCTURED
  DEFAULTED
}

enum Role {
  CEO
  FINANCE_MANAGER
  PROJECT_MANAGER
  STAFF
  CONSULTANT
}

enum ThematicArea {
  HEALTH_NUTRITION
  GOVERNANCE_PUBLIC_SECTOR
  HUMAN_DEVELOPMENT
  CLIMATE_AGRICULTURE
}

enum ProjectType {
  PRIVATE
  PUBLIC
}

enum MilestoneStatus {
  PENDING
  COMPLETION_REQUESTED
  APPROVED
  REJECTED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              Role               @default(FINANCE_MANAGER)
  active            Boolean            @default(true)
  // ── Multi-entity ─────────────────────────────────────────────────────────────
  defaultOrgId      String?            // preferred organisation for this user
  defaultOrg        Organisation?      @relation("UserDefaultOrg", fields: [defaultOrgId], references: [id], onDelete: SetNull)
  permissions       Json?              // null = use role defaults; see lib/permissions.ts
  employeeId        String?            // links to Employee.id for STAFF users
  consultantId      String?            // links to Consultant.id for CONSULTANT users
  // ── Login security ──────────────────────────────────────────────────────────
  failedLoginCount   Int                @default(0)  // reset on successful login
  lockedUntil        DateTime?          // null = not locked
  lastLoginAt        DateTime?          // updated on every successful login
  passwordChangedAt  DateTime?          // updated whenever password changes
  mustChangePassword Boolean            @default(false) // set on new users & admin resets
  // ── TOTP 2FA ────────────────────────────────────────────────────────────────
  totpSecret        String?            // base32 TOTP secret; null = 2FA not configured
  totpEnabled       Boolean            @default(false) // true once user completes setup verification
  totpBackupCodes   String[]           @default([])    // bcrypt-hashed one-time backup codes (8 codes)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs           AuditLog[]
  requestedChanges    PendingChange[]     @relation("RequestedChanges")
  approvedChanges     PendingChange[]     @relation("ApprovedChanges")
  submissions         Submission[]        @relation("SubmittedBy")
  submissionReviews   SubmissionReview[]  @relation("ReviewedBy")
  liquidations        Liquidation[]       @relation("LiquidationBy")
  recurringExpenses   RecurringExpense[]
  accountPayables     AccountPayable[]    @relation("APCreatedBy")
  accountReceivables  AccountReceivable[] @relation("ARCreatedBy")
  milestoneCompletions Milestone[]        @relation("MilestoneCompleter")
  milestoneApprovals  Milestone[]         @relation("MilestoneApprover")
  exchangeRateUpdates   ExchangeRate[]
  procurementsRequested Procurement[]      @relation("ProcurementRequester")
  procurementsReviewed  Procurement[]      @relation("ProcurementReviewer")
  opportunities       Opportunity[]       @relation("OpportunityCreator")
  bidDecisions         BidDecision[]       @relation("BidDecisions")
  submittedRemittances TaxRemittance[]     @relation("RemittanceSubmitter")
  reviewedRemittances  TaxRemittance[]     @relation("RemittanceReviewer")
  performanceReviews   PerformanceReview[] @relation("ReviewSubmitter")
  ceoDecisions         CEODecision[]       @relation("CEODecisionMaker")
  periodsClosedBy      FinancialPeriod[]   @relation("PeriodClosedBy")
  periodsLockedBy      FinancialPeriod[]   @relation("PeriodLockedBy")
  delegationsGranted   ApprovalDelegation[] @relation("DelegationGrantor")
  delegationsReceived  ApprovalDelegation[] @relation("DelegationReceiver")
  // Phase 16 back-relations
  leaveReviews              LeaveRequest[]          @relation("LeaveReviewer")
  applicationReviews        JobApplication[]        @relation("ApplicationReviewer")
  travelReviews             TravelRequest[]         @relation("TravelReviewer")
  contacts                  Contact[]               @relation("ContactCreator")
  jobPostings               JobPosting[]            @relation("JobPostingCreator")
  deliverableSubmissions    DeliverableSubmission[] @relation("DeliverableSubmitter")
  deliverableReviews        DeliverableSubmission[] @relation("DeliverableReviewer")
}

model Project {
  id                 String              @id @default(cuid())
  // ── Multi-entity ─────────────────────────────────────────────────────────────
  organisationId     String?
  organisation       Organisation?       @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name               String
  client             String
  description        String?
  status             ProjectStatus       @default(ACTIVE)
  category           String              @default("REGULAR")  // REGULAR | CONSULTANCY
  thematicArea       ThematicArea?
  projectType        ProjectType?
  projectLead        String?
  projectLeadFee     Float?              // budgeted fee for project lead (consultancy only)
  managementFee      Float?              // management fee charged to client
  personnelCosts     Float?              // total personnel costs (manual for regular; sum of budgeted fees for consultancy)
  fieldworkCosts     Float?              // fieldwork / logistics costs
  startDate          DateTime
  endDate            DateTime?
  budget             Float?
  currency           String              @default("MWK")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  income             Income[]
  expenses           Expense[]
  consultantPayments ConsultantPayment[]
  submissions        Submission[]
  receivables        AccountReceivable[]
  members            ProjectMember[]
  milestones         Milestone[]
  budgetLines        BudgetLine[]
  travelRequests     TravelRequest[]
  pilotProfile       PilotProfile?
}

model Income {
  id             String      @id @default(cuid())
  // ── Multi-entity ─────────────────────────────────────────────────────────────
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id])
  grantId        String?
  grant          DonorGrant? @relation(fields: [grantId], references: [id])
  incomeType     IncomeType  @default(GRANT)
  description    String
  amount         Float
  currency       String      @default("MWK")
  receivedDate   DateTime
  source         String?
  invoiceNumber  String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt      DateTime?
  deletedBy      String?     // userId
  deletionReason String?
}

model Expense {
  id             String   @id @default(cuid())
  // ── Multi-entity ─────────────────────────────────────────────────────────────
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  description    String
  amount         Float
  currency       String   @default("MWK")
  category       String
  paidDate       DateTime
  vendor         String?
  receiptRef     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?
}

model Consultant {
  id                    String              @id @default(cuid())
  name                  String
  email                 String?
  phone                 String?
  specialisation        String?
  dailyRate             Float?
  currency              String              @default("MWK")
  taxPin                String?
  active                Boolean             @default(true)
  projectId             String?             // links to a consultancy Project
  budgetedFee           Float?              // total budgeted fee for this consultant in the project
  totalProfessionalFees Float?              // professional fees component (WHT applies to this)
  otherFees             Float?              // other fees not subject to WHT (e.g. reimbursables)
  withholdingTaxRate    Float               @default(20) // WHT % on professional fees
  supervisorId          String?             // internal contact / supervisor
  supervisor            Employee?           @relation("ConsultantSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  payments              ConsultantPayment[]
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt             DateTime?
  deletedBy             String?
  deletionReason        String?
}

model ConsultantPayment {
  id             String        @id @default(cuid())
  consultantId   String
  consultant     Consultant    @relation(fields: [consultantId], references: [id])
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id])
  description    String
  daysWorked     Float?
  rateUsed       Float?
  grossAmount    Float
  withholdingTax Float         @default(0)
  netAmount      Float
  currency       String        @default("MWK")
  paidDate       DateTime?
  status         PaymentStatus @default(PENDING)
  notes          String?
  whtStatus      String        @default("OUTSTANDING") // OUTSTANDING | PENDING_CEO | REMITTED | WAIVED
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?
}

model Employee {
  id                 String    @id @default(cuid())
  // ── Multi-entity ─────────────────────────────────────────────────────────────
  organisationId     String?
  organisation       Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  employeeNumber     String?   @unique       // auto-generated e.g. EMP-001
  name               String
  email              String?
  position           String
  level              String?               // Executive | Senior Manager | Manager | Officer | Support Staff
  departments        String[] @default([])  // e.g. ["Finance","Projects","Business Development"]
  contractType         String    @default("PERMANENT") // PERMANENT | CONTRACT | CONSULTANCY | INTERNSHIP | VOLUNTEER
  contractLengthMonths Int?                           // null = indefinite; populated for fixed-term types
  grossSalary        Float
  currency           String    @default("MWK")
  taxPin             String?
  nssf               String?
  pensionRate        Float     @default(5)   // employee pension % of gross
  payeExempt         Boolean   @default(false) // true = PAYE not deducted (e.g. volunteers, exempt staff)
  nssfApplicable     Boolean   @default(false) // true = NSSF contributions apply
  nssfEmployeeRate   Float     @default(3)   // NSSF employee contribution %
  nssfEmployerRate   Float     @default(3)   // NSSF employer contribution %
  salaryExchangeRate Float?                  // MWK per 1 unit of currency (null when MWK)
  startDate          DateTime
  endDate            DateTime?
  active             Boolean   @default(true)
  notes              String?
  supervisorId       String?             // links to another Employee who is the direct supervisor
  supervisor         Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  subordinates       Employee[] @relation("EmployeeSupervisor")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  payrolls           Payroll[]
  performanceCycles  PerformanceCycle[]
  timesheets         Timesheet[]
  supervisedConsultants Consultant[] @relation("ConsultantSupervisor")
  // Phase 16 back-relations
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  qualifications     Qualification[]
  trainingRecords    TrainingRecord[]
  travelRequests     TravelRequest[]
}

model Payroll {
  id              String        @id @default(cuid())
  // ── Multi-entity ─────────────────────────────────────────────────────────────
  organisationId  String?
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  // ── PAYE band versioning ──────────────────────────────────────────────────────
  payeBandSetId   String?       // which PAYEBandSet was active when this was calculated
  payeBandSet     PAYEBandSet?  @relation(fields: [payeBandSetId], references: [id], onDelete: SetNull)
  payeBandSnapshot Json?        // JSON snapshot of bands at time of calculation
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period          String
  grossSalary     Float
  paye            Float         @default(0)
  pension         Float         @default(0)   // employee pension in employee's currency
  pensionEmployer Float         @default(0)   // employer pension contribution in MWK
  nssfEmployee    Float         @default(0)
  nssfEmployer    Float         @default(0)
  otherAdditions  Float         @default(0)   // per-period additions (refunds, bonuses, etc.)
  additionNote    String?
  otherDeductions Float         @default(0)
  deductionNote   String?
  netPay          Float
  currency        String        @default("MWK")
  paidDate        DateTime?
  status          PaymentStatus @default(PENDING)
  notes           String?
  payeStatus      String        @default("OUTSTANDING") // OUTSTANDING | PENDING_CEO | REMITTED | WAIVED
  pensionStatus   String        @default("OUTSTANDING") // OUTSTANDING | PENDING_CEO | REMITTED | WAIVED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  overspendingRefunds OverspendingRefund[]
  // ── Payroll lock (set when CEO approves the run — record becomes read-only) ─
  lockedAt        DateTime?
  lockedBy        String?       // CEO userId
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt       DateTime?
  deletedBy       String?
  deletionReason  String?
}

model Debt {
  id             String          @id @default(cuid())
  // ── Multi-entity ─────────────────────────────────────────────────────────────
  organisationId String?
  organisation   Organisation?   @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  lender         String
  description    String
  principal      Float
  currency       String          @default("MWK")
  interestRate   Float?
  disbursedDate  DateTime
  dueDate        DateTime?
  status         DebtStatus      @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  repayments     DebtRepayment[]
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?
}

model DebtRepayment {
  id             String   @id @default(cuid())
  debtId         String
  debt           Debt     @relation(fields: [debtId], references: [id])
  amount         Float
  currency       String   @default("MWK")
  paidDate       DateTime
  notes          String?
  createdAt      DateTime @default(now())
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?
}

model TaxConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Float
  label     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

// ── Enhanced audit trail (Phase 1 — immutable, tamper-evident) ───────────────
// Every create/update/delete on a financial model writes one row here.
// This table has NO updatedAt — rows are never modified after insert.
// The checksum covers all fields so any tampering is detectable.
model AuditEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  // Who
  userId        String?                // null for system/pre-auth events
  userEmail     String   @default("")  // denormalised — survives user deletion
  userName      String   @default("")  // denormalised
  userRole      String   @default("")  // role at time of action
  // Where from
  ipAddress     String   @default("unknown")
  userAgent     String   @default("unknown")
  sessionId     String?
  // What
  action        String   // CREATE | UPDATE | DELETE | APPROVE | REJECT | SUBMIT | LOGIN | LOGOUT | EXPORT | LOCK
  entityType    String   // Prisma model name
  entityId      String?
  previousValue Json?    // full record snapshot before change
  newValue      Json?    // full record snapshot after change
  changedFields String[] @default([])  // field names that changed
  detail        String?
  // Integrity
  checksum      String   @default("") // SHA-256 of all fields — tamper detection
}

// ── Immutable approval chain ──────────────────────────────────────────────────
// Every status transition on an approvable entity writes one row here.
// This table has NO updatedAt — rows are never modified after insert.
model ApprovalRecord {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  entityType      String   // "TaxRemittance" | "Submission" | "Liquidation" | "Procurement" | "Payroll" …
  entityId        String
  decidedById     String
  decidedByEmail  String   // denormalised
  decidedByName   String   // denormalised
  decidedByRole   String   // denormalised
  previousStatus  String
  newStatus       String
  decision        String   // SUBMITTED | APPROVED | REJECTED | CHANGES_REQUESTED | LOCKED | UNLOCKED
  comments        String?
  ipAddress       String   @default("unknown")
  checksum        String   @default("") // SHA-256 tamper detection
}

// ── Security event log ────────────────────────────────────────────────────────
model LoginEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  email         String   // attempted email address
  userId        String?  // null for failed attempts or unknown users
  success       Boolean
  ipAddress     String   @default("unknown")
  userAgent     String   @default("unknown")
  failureReason String?  // INVALID_PASSWORD | USER_NOT_FOUND | ACCOUNT_INACTIVE | ACCOUNT_LOCKED
}

// ── Per-email brute-force lockout tracker ────────────────────────────────────
model LoginAttempt {
  id            String    @id @default(cuid())
  email         String    @unique
  attempts      Int       @default(0)
  lastAttemptAt DateTime  @default(now())
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt
}

enum ChangeType {
  EDIT
  DELETE
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model PendingChange {
  id          String       @id @default(cuid())
  entity      String       // "Income" | "Expense"
  entityId    String
  changeType  ChangeType
  status      ChangeStatus @default(PENDING)
  requestedBy String
  requester   User         @relation("RequestedChanges", fields: [requestedBy], references: [id])
  approvedBy  String?
  approver    User?        @relation("ApprovedChanges", fields: [approvedBy], references: [id])
  snapshot    Json         // original record at time of request
  proposed    Json?        // new values for EDIT (null for DELETE)
  reason      String?
  reviewNote  String?
  createdAt   DateTime     @default(now())
  reviewedAt  DateTime?
}

// ── Submission (Invoice / Request) ──────────────────────────────

enum SubmissionType {
  INVOICE
  REQUEST
}

enum SubmissionStatus {
  PENDING_FM
  FM_CHANGES_REQUESTED
  PENDING_CEO
  CEO_CHANGES_REQUESTED
  APPROVED    // CEO approved — FM to process payment
  PAID
  REJECTED
}

enum ReviewAction {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

model Submission {
  id           String           @id @default(cuid())
  submittedBy  String
  submitter    User             @relation("SubmittedBy", fields: [submittedBy], references: [id])
  type         SubmissionType
  status       SubmissionStatus @default(PENDING_FM)

  // Invoice-specific
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id])
  milestone    String?

  // Request-specific
  purpose      String?
  requestDate  DateTime?
  activityDate DateTime?
  budgetLine   String?          // "ADMIN" or project name

  // Common
  currency     String           @default("MWK")
  totalAmount  Float            @default(0)
  notes        String?
  liquidationDeadline DateTime?  // 14 days after last activity day (set when marked PAID)

  lineItems    SubmissionItem[]
  reviews      SubmissionReview[]
  liquidations Liquidation[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt    DateTime?
  deletedBy    String?
  deletionReason String?
}

model SubmissionItem {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  item         String
  description  String?
  activityDate DateTime?
  amount       Float
  createdAt    DateTime   @default(now())
}

model SubmissionReview {
  id           String       @id @default(cuid())
  submissionId String
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewedBy   String
  reviewer     User         @relation("ReviewedBy", fields: [reviewedBy], references: [id])
  reviewerRole String       // "FM" | "CEO"
  action       ReviewAction
  note         String?
  createdAt    DateTime     @default(now())
}

// ── Liquidation ─────────────────────────────────────────────────

enum LiquidationStatus {
  PENDING_FM
  CHANGES_REQUESTED
  FM_APPROVED
  FM_REJECTED
}

enum DocType {
  RECEIPT
  REFUND_PROOF
  OVER_EXPENDITURE_PROOF
  PRIOR_APPROVAL_PROOF
}

model Liquidation {
  id                String            @id @default(cuid())
  submissionId      String
  submission        Submission        @relation(fields: [submissionId], references: [id])
  submittedBy       String
  submitter         User              @relation("LiquidationBy", fields: [submittedBy], references: [id])

  liquidationDate   DateTime
  activity          String
  budgetLine        String
  fundsReceived     Float
  fundsAccountedFor Float
  refundRequired    Float             // positive = owes back; negative = overspent
  currency          String            @default("MWK")

  status            LiquidationStatus @default(PENDING_FM)
  fmNote            String?
  reviewedByName    String?
  reviewedAt        DateTime?

  documents         LiquidationDocument[]
  overspendingRefunds OverspendingRefund[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt         DateTime?
  deletedBy         String?
  deletionReason    String?
}

// Tracks overspent amounts awaiting CEO approval for payroll reimbursement
model OverspendingRefund {
  id             String      @id @default(cuid())
  liquidationId  String
  liquidation    Liquidation @relation(fields: [liquidationId], references: [id])
  employeeName   String
  employeeId     String?     // null if submitter is not linked to an employee
  amount         Float       // absolute overspent amount in the liquidation currency
  currency       String      @default("MWK")
  status         String      @default("PENDING_CEO") // PENDING_CEO | CEO_APPROVED | PAYROLL_ADDED
  ceoNote        String?
  payrollId      String?     // set when added to a payroll run
  payroll        Payroll?    @relation(fields: [payrollId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model LiquidationDocument {
  id            String      @id @default(cuid())
  liquidationId String
  liquidation   Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  docType       DocType
  url           String
  filename      String
  uploadedAt    DateTime    @default(now())
}

// ── Recurring Expenses & AP/AR ───────────────────────────────────

enum RecurringFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum PayableStatus {
  UPCOMING
  DUE
  PAID
  OVERDUE
  CANCELLED
}

enum ReceivableStatus {
  EXPECTED
  RECEIVED
  PARTIAL
  OVERDUE
  CANCELLED
}

model RecurringExpense {
  id          String             @id @default(cuid())
  name        String
  description String?
  amount      Float
  currency    String             @default("MWK")
  category    String?
  budgetLine  String?
  vendor      String?
  frequency   RecurringFrequency
  startDate   DateTime
  endDate     DateTime?
  active      Boolean            @default(true)
  createdBy   String
  creator     User               @relation(fields: [createdBy], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  payables    AccountPayable[]
}

model AccountPayable {
  id                 String            @id @default(cuid())
  description        String
  vendor             String?
  amount             Float
  currency           String            @default("MWK")
  dueDate            DateTime
  paidDate           DateTime?
  status             PayableStatus     @default(UPCOMING)
  note               String?
  budgetLine         String?
  reminderSent       Boolean           @default(false)
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  createdBy          String
  creator            User              @relation("APCreatedBy", fields: [createdBy], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt          DateTime?
  deletedBy          String?
  deletionReason     String?
}

model AccountReceivable {
  id           String           @id @default(cuid())
  description  String
  payer        String?
  amount       Float
  currency     String           @default("MWK")
  expectedDate DateTime
  receivedDate DateTime?
  status       ReceivableStatus @default(EXPECTED)
  note         String?
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id])
  milestoneId  String?          @unique
  milestone    Milestone?       @relation(fields: [milestoneId], references: [id])
  createdBy    String
  creator      User             @relation("ARCreatedBy", fields: [createdBy], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt    DateTime?
  deletedBy    String?
  deletionReason String?
}

// ── Project Members & Milestones ─────────────────────────────────

model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  role        String
  budgetedFee Float?   // budgeted fee for this member (consultancy projects only)
  createdAt   DateTime @default(now())
}

// ── Exchange Rates (RBM middle rates) ───────────────────────────

model ExchangeRate {
  id            String   @id @default(cuid())
  currency      String   @unique          // ISO code e.g. "USD"
  buyRate       Float
  middleRate    Float
  sellRate      Float
  effectiveDate DateTime                  // Date on the RBM table
  source        String   @default("RBM") // "RBM" | "MANUAL"
  updatedAt     DateTime @updatedAt
  updatedById   String?
  updatedBy     User?    @relation(fields: [updatedById], references: [id])
}

// ── Assets Register ──────────────────────────────────────────────────────────

model Asset {
  id            String          @id @default(cuid())
  assetNumber   String?         @unique    // auto-generated e.g. A-0001
  name          String
  category      String                     // FURNITURE | IT_EQUIPMENT | MOTOR_VEHICLE | OFFICE_EQUIPMENT | LAND_BUILDING | OTHER
  description   String?
  serialNumber  String?
  location      String?
  condition     String          @default("GOOD") // EXCELLENT | GOOD | FAIR | POOR | WRITTEN_OFF
  purchaseDate  DateTime?
  purchasePrice Float?
  currency      String          @default("MWK")
  supplier      String?
  insurable     Boolean         @default(false)
  active        Boolean         @default(true)
  notes         String?
  insurance     AssetInsurance?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt     DateTime?
  deletedBy     String?
  deletionReason String?
}

model AssetInsurance {
  id             String   @id @default(cuid())
  assetId        String   @unique
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  insurer        String
  policyNumber   String?
  premium        Float?
  currency       String   @default("MWK")
  coverageAmount Float?
  startDate      DateTime
  expiryDate     DateTime
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Procurement ───────────────────────────────────────────────────────────────

enum ProcurementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model Procurement {
  id            String               @id @default(cuid())
  title         String
  description   String?
  category      String?
  estimatedCost Float
  currency      String               @default("MWK")
  status        ProcurementStatus    @default(DRAFT)
  requestedBy   String
  requester     User                 @relation("ProcurementRequester", fields: [requestedBy], references: [id])
  reviewedBy    String?
  reviewer      User?                @relation("ProcurementReviewer", fields: [reviewedBy], references: [id])
  reviewNote    String?
  reviewedAt    DateTime?
  quotations    ProcurementQuotation[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt     DateTime?
  deletedBy     String?
  deletionReason String?
}

model ProcurementQuotation {
  id            String      @id @default(cuid())
  procurementId String
  procurement   Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  supplier      String
  amount        Float
  currency      String      @default("MWK")
  documentUrl   String?     // link to uploaded quotation document
  notes         String?
  uploadedAt    DateTime    @default(now())
}

// ── Business Development ──────────────────────────────────────────────────────

model Opportunity {
  id                    String    @id @default(cuid())
  name                  String
  classification        String    // CONSULTANCY | ADVISORY | IMPLEMENTATION
  funder                String?
  thematicArea          String?   // mirrors ThematicArea enum values
  deadline              DateTime?
  link                  String?
  notes                 String?
  status                String    @default("OPEN") // OPEN | SUBMITTED
  submittedAt           DateTime?
  bidStatus             String?   // null | WON | REJECTED
  linkedProjectId       String?   // project created when won
  // Deletion workflow for no-feedback opportunities
  deletionRequestedBy   String?
  deletionRequestedAt   DateTime?
  deletionApprovedBy    String?
  createdBy             String
  creator               User      @relation("OpportunityCreator", fields: [createdBy], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ── Opportunity Intelligence Engine ──────────────────────────────────────────

enum IntelSourceType {
  RSS
  HTML
  PLAYWRIGHT
  WPJOBS
}

enum IntelCrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum IntelOpportunityType {
  CONSULTANCY
  GRANT
  STARTUP_FUNDING
}

enum IntelPillarTag {
  EVIDENCE_GENERATION
  POLICY_ADVISORY
  PROGRAMME_IMPLEMENTATION
}

enum IntelThematicTag {
  HEALTH_NUTRITION
  GOVERNANCE_PUBLIC_SECTOR
  HUMAN_DEVELOPMENT
  CLIMATE_AGRICULTURE
}

enum IntelStatus {
  NEW
  REVIEWED
  ACCEPTED
  IGNORED
  DUPLICATE
}

enum IntelFit {
  HIGH
  MEDIUM
  LOW
}

model CrawlerSource {
  id              String                  @id @default(cuid())
  name            String
  url             String
  sourceType      IntelSourceType
  active          Boolean                 @default(true)
  description     String?
  country         String                  @default("Malawi")
  tags            String[]                // AI hints e.g. ["evaluation", "consultancy"]
  crawlIntervalMins Int                   @default(360)
  lastCrawledAt   DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  crawlRuns       CrawlRun[]
  discoveries     DiscoveredOpportunity[]
}

model CrawlRun {
  id           String           @id @default(cuid())
  sourceId     String
  source       CrawlerSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status       IntelCrawlStatus @default(PENDING)
  itemsFound   Int              @default(0)
  itemsNew     Int              @default(0)
  errorMsg     String?
  startedAt    DateTime         @default(now())
  completedAt  DateTime?
}

model DiscoveredOpportunity {
  id              String               @id @default(cuid())
  sourceId        String
  source          CrawlerSource        @relation(fields: [sourceId], references: [id])

  // Raw data from crawler
  rawTitle        String
  rawDescription  String?
  rawUrl          String
  rawPublishedAt  DateTime?
  rawDeadline     String?
  rawFunder       String?
  rawContent      String?

  // Deduplication fingerprints
  urlHash         String               @unique // SHA-256 of normalised URL
  contentHash     String?              // SHA-256 of trimmed raw content

  // Processing status
  status          IntelStatus          @default(NEW)
  duplicateOf     String?              // ID of original if DUPLICATE

  // Structured (AI-extracted)
  title           String?
  description     String?
  deadline        DateTime?
  funder          String?
  country         String?
  valueEstimate   String?
  opportunityType IntelOpportunityType?
  pillarTags      IntelPillarTag[]
  thematicTags    IntelThematicTag[]

  // Relations
  analysis        OpportunityAnalysis?
  decision        BidDecision?
  linkedOpportunityId String?          // BD Opportunity created on accept

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model OpportunityAnalysis {
  id                   String                @id @default(cuid())
  discoveredOpId       String                @unique
  discoveredOp         DiscoveredOpportunity @relation(fields: [discoveredOpId], references: [id], onDelete: Cascade)

  strategicFit         IntelFit
  competitivenessScore Int                   // 1–10
  priorityScore        Int                   // 1–10 composite
  recommendation       String                // PURSUE | MONITOR | PASS
  rationale            String?
  strengths            String[]
  risks                String[]
  estimatedValue       String?
  timeToDeadlineDays   Int?

  modelVersion         String               @default("claude-opus-4-5")
  analysedAt           DateTime             @default(now())
}

model BidDecision {
  id             String                @id @default(cuid())
  discoveredOpId String                @unique
  discoveredOp   DiscoveredOpportunity @relation(fields: [discoveredOpId], references: [id], onDelete: Cascade)

  decision       String                // ACCEPTED | IGNORED
  decidedBy      String
  decider        User                  @relation("BidDecisions", fields: [decidedBy], references: [id])
  note           String?
  decidedAt      DateTime              @default(now())
}

model Milestone {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  deliveryDate    DateTime
  paymentExpected Float?
  currency        String          @default("MWK")
  order           Int             @default(0)
  feePercentage   Float?          // % of total personnel fees this milestone represents (consultancy only)
  status          MilestoneStatus @default(PENDING)
  completedBy     String?
  completedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  rejectionNote   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completer       User?           @relation("MilestoneCompleter", fields: [completedBy], references: [id])
  approver        User?           @relation("MilestoneApprover", fields: [approvedBy], references: [id])
  receivable      AccountReceivable?
  deliverableSubmissions DeliverableSubmission[]
}


// ── Tax Remittances ───────────────────────────────────────────────────────────

model TaxRemittance {
  id                   String    @id @default(cuid())
  taxType              String    // PAYE | WHT | PENSION | CIT
  period               String    // descriptive label, e.g. "Jan 2026" or "Q1 2026"
  amount               Float
  currency             String    @default("MWK")
  remittanceType       String    @default("PAID") // PAID | WAIVED
  proofUrl             String?
  proofFilename        String?
  status               String    @default("PENDING_CEO") // PENDING_CEO | CEO_APPROVED | CEO_REJECTED
  fmNote               String?
  ceoNote              String?
  submittedById        String
  submittedBy          User      @relation("RemittanceSubmitter", fields: [submittedById], references: [id])
  reviewedById         String?
  reviewedBy           User?     @relation("RemittanceReviewer", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  payrollIds           String[]  @default([])
  consultantPaymentIds String[]  @default([])
  pensionIds           String[]  @default([])  // payroll IDs for PENSION remittances
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  // ── Soft delete ─────────────────────────────────────────────────────────────
  deletedAt            DateTime?
  deletedBy            String?
  deletionReason       String?
}

// ── Performance Management ────────────────────────────────────────────────────

// Cycle statuses:
// OBJECTIVES_DRAFT → OBJECTIVES_SUBMITTED → OBJECTIVES_APPROVED →
// REVIEWING (employee self-review done) → SUPERVISOR_DONE → CEO_PENDING → COMPLETED

model PerformanceCycle {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleType    String   // PROBATION | H1 | H2 | ANNUAL
  year         Int
  startDate    DateTime
  endDate      DateTime
  status       String   @default("OBJECTIVES_DRAFT")
  supervisorNote String?  // note from supervisor when approving/rejecting objectives
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  objectives   PerformanceObjective[]
  reviews      PerformanceReview[]
  ceoDecision  CEODecision?
}

model PerformanceObjective {
  id          String           @id @default(cuid())
  cycleId     String
  cycle       PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  weight      Float?           // % weighting (should sum to 100 across cycle)
  target      String?          // measurable target / KPI
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  ratings     ObjectiveRating[]
}

model PerformanceReview {
  id            String           @id @default(cuid())
  cycleId       String
  cycle         PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewType    String           // SELF | SUPERVISOR
  submittedById String
  submittedBy   User             @relation("ReviewSubmitter", fields: [submittedById], references: [id])
  overallRating Float?           // 1.0–5.0
  strengths     String?
  improvements  String?
  comments      String?
  submittedAt   DateTime?
  status        String           @default("DRAFT") // DRAFT | SUBMITTED
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  ratings       ObjectiveRating[]

  @@unique([cycleId, reviewType])
}

model ObjectiveRating {
  id          String               @id @default(cuid())
  reviewId    String
  review      PerformanceReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  objectiveId String
  objective   PerformanceObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  rating      Float                // 1–5
  comment     String?
}

model CEODecision {
  id           String           @id @default(cuid())
  cycleId      String           @unique
  cycle        PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  overallScore Float?
  outcome      String?          // CONFIRMED | PROMOTED | EXTENDED_PROBATION | PERFORMANCE_IMPROVEMENT | TERMINATED
  comments     String?
  decidedById  String?
  decidedBy    User?            @relation("CEODecisionMaker", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// ── Timesheets ────────────────────────────────────────────────────────────────

model Timesheet {
  id             String           @id @default(cuid())
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month          Int              // 1–12
  year           Int
  status         String           @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  supervisorNote String?
  reviewedAt     DateTime?
  entries        TimesheetEntry[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([employeeId, month, year])
}

// ── Centralised Document Library ──────────────────────────────────────────────
//
// Phase 2 — Document Management.
// Every uploaded file lives here with full metadata, entity linkage, uploader
// identity (denormalised for audit permanence), and an optional retention policy.
//
// entityType / entityId form a polymorphic link to any entity in the system.
// Queries: prisma.document.findMany({ where: { entityType: "Procurement", entityId: id } })

model Document {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())

  // ── File metadata ──────────────────────────────────────────────────────────
  title           String                          // user-facing name
  filename        String                          // original file name
  url             String                          // Vercel Blob URL
  fileSize        Int?                            // bytes
  mimeType        String?

  // ── Classification ─────────────────────────────────────────────────────────
  // RECEIPT | CONTRACT | REPORT | CORRESPONDENCE | POLICY | EVIDENCE | MINUTES | DELIVERABLE | OTHER
  category        String
  description     String?
  tags            String[]  @default([])

  // ── Polymorphic entity link ─────────────────────────────────────────────────
  // null = standalone / general library document
  entityType      String?   // "Submission" | "Procurement" | "Project" | "TaxRemittance" | "Liquidation" …
  entityId        String?

  // ── Uploader identity (denormalised — survives account deletion) ───────────
  uploadedById    String
  uploadedByName  String
  uploadedByEmail String
  uploadedByRole  String

  // ── Retention ──────────────────────────────────────────────────────────────
  retentionYears  Int?      // null = indefinite

  // ── Soft delete ────────────────────────────────────────────────────────────
  deletedAt       DateTime?
  deletedBy       String?

  @@index([entityType, entityId])
  @@index([category])
  @@index([uploadedById])
  @@index([createdAt])
}

// ── Phase 5: Financial Period Closing ─────────────────────────────────────────
//
// A FinancialPeriod record is only created when a month transitions from OPEN.
// Absence of a record = period is OPEN.
// CLOSED = FM has closed the period; no new income/expense entries allowed.
// LOCKED = CEO has locked the period for donor submission; immutable checksum stored.

model FinancialPeriod {
  id          String    @id @default(cuid())
  // "YYYY-MM" — unique identifier for the month
  periodKey   String    @unique
  year        Int
  month       Int       // 1-12
  // OPEN | CLOSED | LOCKED
  status      String    @default("OPEN")
  closedAt    DateTime?
  closedById  String?
  closedBy    User?     @relation("PeriodClosedBy", fields: [closedById], references: [id])
  lockedAt    DateTime?
  lockedById  String?
  lockedBy    User?     @relation("PeriodLockedBy", fields: [lockedById], references: [id])
  // SHA-256 hash of all period records at lock time — tamper evidence
  checksum    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([year, month])
}

// ── Phase 6: Donor Grant Tracking ─────────────────────────────────────────────
//
// DonorGrant links a named funding award to income records and budget lines.
// Utilisation = sum of spending on linked budget lines vs. totalAmount awarded.
// Income records are linked directly so received-vs-awarded can also be tracked.

model DonorGrant {
  id              String    @id @default(cuid())
  // ── Multi-entity ─────────────────────────────────────────────────────────────
  organisationId  String?
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name            String                          // full grant/project title
  grantNumber     String?                         // donor reference / contract number
  donorName       String                          // "European Union", "USAID", etc.
  // BILATERAL | MULTILATERAL | FOUNDATION | CORPORATE | GOVERNMENT | OTHER
  donorType       String    @default("BILATERAL")
  totalAmount     Float                           // total award amount
  currency        String    @default("MWK")
  startDate       DateTime
  endDate         DateTime?
  // QUARTERLY | SEMI-ANNUAL | ANNUAL
  reportingPeriod String?
  // ACTIVE | COMPLETED | SUSPENDED | CANCELLED
  status          String    @default("ACTIVE")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  income      Income[]      // receipts linked to this grant
  budgetLines BudgetLine[]  // spending envelopes funded by this grant
  contacts    Contact[]     // relationship contacts for this grant

  @@index([status])
  @@index([donorName])
}

// ── Phase 4: Budget Integrity & Compliance ────────────────────────────────────
//
// BudgetLine — a named spending envelope with an optional ceiling.
// The `name` field matches the free-text `budgetLine` field on Submission,
// Liquidation, AccountPayable, and RecurringExpense records, allowing
// utilisation to be aggregated without a schema migration on those models.
//
// ProcurementThreshold — defines quotation requirements by amount tier.
// Replaces the hardcoded >=100,000 / 3-quotation rule in the procurement page.

model BudgetLine {
  id          String      @id @default(cuid())
  // Matches the `budgetLine` string stored on transactions
  name        String      @unique
  description String?
  // PERSONNEL | OPERATIONS | ADMIN | TRAVEL | EQUIPMENT | CONSULTANCY | OTHER
  category    String      @default("OTHER")
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  grantId     String?
  grant       DonorGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  fiscalYear  Int
  ceiling     Float?      // null = no cap
  currency    String      @default("MWK")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([fiscalYear])
  @@index([projectId])
  @@index([grantId])
}

model ProcurementThreshold {
  id             String   @id @default(cuid())
  label          String                          // e.g. "Direct Purchase"
  minAmount      Float    @default(0)
  maxAmount      Float?                          // null = no upper bound
  minQuotations  Int      @default(1)
  requiresTender Boolean  @default(false)
  currency       String   @default("MWK")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TimesheetEntry {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date        DateTime  // specific day (time portion ignored)
  activity    String    // description of what was done
  project     String?   // project name / budget line (optional)
  hours       Float     // hours spent on this activity
  createdAt   DateTime  @default(now())
}

// ── Phase 14: Bank Reconciliation ─────────────────────────────────────────────
//
// Workflow:
//   1. FM uploads a CSV bank statement → BankStatement + BankTransaction rows created.
//   2. Auto-match runs: pairs transactions to Income/Expense/Payroll by date ± 3 days
//      and amount within 1% tolerance.
//   3. FM reviews auto-matches, manually matches remaining, or marks as UNMATCHED.
//   4. When all rows are reviewed, FM marks the statement as RECONCILED.

model BankStatement {
  id            String             @id @default(cuid())
  // Bank account details (free-text, not a FK — may be external)
  accountName   String
  bankName      String
  currency      String             @default("MWK")
  // Statement date range
  fromDate      DateTime
  toDate        DateTime
  // Processing state
  status        String             @default("PENDING") // PENDING | IN_REVIEW | RECONCILED
  uploadedById  String
  reconciledById String?
  reconciledAt  DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  transactions  BankTransaction[]
}

model BankTransaction {
  id              String              @id @default(cuid())
  statementId     String
  statement       BankStatement       @relation(fields: [statementId], references: [id], onDelete: Cascade)
  // Raw fields from the CSV
  transactionDate DateTime
  description     String
  debit           Float?              // amount leaving the account (positive)
  credit          Float?              // amount entering the account (positive)
  balance         Float?              // running balance after this transaction
  // Matching state
  matchStatus     String              @default("UNMATCHED") // UNMATCHED | AUTO_MATCHED | MANUAL_MATCHED | EXCLUDED
  // Polymorphic link to the matched system record
  matchEntityType String?             // "Income" | "Expense" | "Payroll" | "AccountPayable"
  matchEntityId   String?
  matchNote       String?
  matchedAt       DateTime?
  matchedById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([statementId, matchStatus])
  @@index([transactionDate])
}

// ── Phase 12: Approval Delegation ─────────────────────────────────────────────
//
// CEO can temporarily delegate their approval authority to another user.
// Active when: isActive = true AND today is within [startDate, endDate].
// The delegate's actions are attributed "on behalf of CEO" in audit logs.

model ApprovalDelegation {
  id           String    @id @default(cuid())
  // CEO granting the delegation
  delegatorId  String
  delegator    User      @relation("DelegationGrantor", fields: [delegatorId], references: [id])
  // User receiving the delegation
  delegateeId  String
  delegatee    User      @relation("DelegationReceiver", fields: [delegateeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean   @default(true)
  notes        String?
  revokedAt    DateTime? // set when manually revoked early
  revokedById  String?   // who revoked it
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([delegateeId, isActive])
  @@index([delegatorId])
}

// ── Phase 15: Multi-Entity Organisation Support ───────────────────────────────
//
// Allows Astelfin to manage multiple registered legal entities (e.g. a
// consultancy arm and a charitable trust) under a single installation.
// All core financial models carry an optional organisationId — null = legacy /
// untagged record (belongs to all contexts by default).
// The active entity is stored in the `astelfin_org` cookie and resolved server-
// side via lib/org.ts.

model Organisation {
  id                 String    @id @default(cuid())
  name               String                          // full legal name
  shortCode          String    @unique               // e.g. "CONSULT" | "TRUST"
  // CONSULTANCY | CHARITABLE_TRUST | NGO | COMPANY | OTHER
  type               String    @default("COMPANY")
  registrationNumber String?
  taxPin             String?
  active             Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations back to financial models
  defaultUsers       User[]         @relation("UserDefaultOrg")
  projects           Project[]
  incomes            Income[]
  expenses           Expense[]
  employees          Employee[]
  payrolls           Payroll[]
  debts              Debt[]
  donorGrants        DonorGrant[]

  @@index([active])
}

// ── Phase 15: PAYE Band Versioning ────────────────────────────────────────────
//
// Each PAYEBandSet represents a specific set of MRA tax bands valid from a given
// date (effectiveFrom). The "active" set for a payroll period is the one with the
// highest effectiveFrom that is <= the period start date.
//
// When a payroll run is saved, the active band set ID and a JSON snapshot of the
// bands are stored on the Payroll record so historical calculations remain stable
// even after MRA changes rates.

model PAYEBandSet {
  id            String     @id @default(cuid())
  label         String                             // e.g. "MRA Bands 2024/25"
  effectiveFrom DateTime                           // date these bands took effect
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  bands         PAYEBand[]
  payrolls      Payroll[]

  @@index([effectiveFrom])
}

model PAYEBand {
  id          String      @id @default(cuid())
  bandSetId   String
  bandSet     PAYEBandSet @relation(fields: [bandSetId], references: [id], onDelete: Cascade)
  order       Int                                  // ascending sort order (1, 2, 3 …)
  fromAmount  Float                                // lower bound (inclusive)
  toAmount    Float?                               // upper bound (exclusive); null = no upper bound
  rate        Float                                // marginal tax rate as a percentage (e.g. 30 = 30%)
  createdAt   DateTime    @default(now())

  @@index([bandSetId, order])
}

// ── Phase 16: Employee Leave Management ───────────────────────────────────────

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  STUDY
  COMPASSIONATE
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeavePolicy {
  id          String    @id @default(cuid())
  leaveType   LeaveType @unique
  daysPerYear Float                          // default annual entitlement
  carryOver   Float     @default(0)          // max days that roll to next year
  notes       String?
  updatedAt   DateTime  @updatedAt
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year        Int
  leaveType   LeaveType
  entitled    Float                          // days entitled this year (policy + adjustments)
  used        Float     @default(0)          // days consumed by approved requests
  adjustment  Float     @default(0)          // manual FM/CEO adjustment (positive or negative)
  adjustNote  String?
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, year, leaveType])
  @@index([employeeId, year])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType
  startDate    DateTime
  endDate      DateTime
  days         Float                          // working days (calculated)
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId, status])
  @@index([startDate, endDate])
}

// ── Phase 16: Recruitment Workflow ────────────────────────────────────────────

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW_SCHEDULED
  INTERVIEWED
  SHORTLISTED
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model JobPosting {
  id           String        @id @default(cuid())
  title        String
  department   String?
  description  String
  requirements String?
  contractType String        @default("PERMANENT") // mirrors Employee.contractType
  location     String?
  // DRAFT | OPEN | CLOSED | FILLED
  status       String        @default("DRAFT")
  deadline     DateTime?
  salary       String?       // descriptive range, not a number
  createdById  String
  createdBy    User          @relation("JobPostingCreator", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications JobApplication[]
}

model JobApplication {
  id             String            @id @default(cuid())
  jobPostingId   String
  jobPosting     JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicantName  String
  applicantEmail String?
  applicantPhone String?
  cvUrl          String?           // uploaded document URL
  coverLetterUrl String?
  status         ApplicationStatus @default(APPLIED)
  interviewDate  DateTime?
  interviewNotes String?
  offerDate      DateTime?
  offerAmount    Float?
  offerCurrency  String            @default("MWK")
  notes          String?
  reviewedById   String?
  reviewedBy     User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([jobPostingId, status])
}

// ── Phase 16: Training, Qualifications & CPD ──────────────────────────────────

enum TrainingType {
  INTERNAL
  EXTERNAL
  ONLINE
  CONFERENCE
  WORKSHOP
}

model Qualification {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title            String                        // e.g. "BSc Economics"
  institution      String
  // DEGREE | DIPLOMA | CERTIFICATE | PROFESSIONAL | OTHER
  qualificationType String  @default("DEGREE")
  awardDate        DateTime?
  expiryDate       DateTime?                     // null = does not expire
  documentUrl      String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TrainingRecord {
  id            String       @id @default(cuid())
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title         String
  provider      String?
  trainingType  TrainingType @default(EXTERNAL)
  startDate     DateTime
  endDate       DateTime?
  hoursCompleted Float?
  cpdPoints     Float?                           // Continuing Professional Development points
  certificateUrl String?
  expiryDate    DateTime?                        // when certification expires
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([employeeId])
}

// ── Phase 16: Travel & Logistics Management ───────────────────────────────────

enum TravelStatus {
  DRAFT
  PENDING_FM
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model TravelRequest {
  id                 String       @id @default(cuid())
  employeeId         String
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  purpose            String
  destination        String
  departureDate      DateTime
  returnDate         DateTime
  // Advance
  advanceRequested   Float        @default(0)
  advanceCurrency    String       @default("MWK")
  advancePaid        Float        @default(0)    // actual amount disbursed
  advancePaidDate    DateTime?
  // Per diem
  perDiemRate        Float        @default(0)    // daily rate in perDiemCurrency
  perDiemCurrency    String       @default("MWK")
  perDiemDays        Float        @default(0)
  perDiemTotal       Float        @default(0)    // computed: rate × days
  // Other costs
  transportCost      Float        @default(0)
  accommodationCost  Float        @default(0)
  otherCosts         Float        @default(0)
  totalCost          Float        @default(0)    // sum of all costs
  // Liquidation
  amountAccountedFor Float        @default(0)
  refundDue          Float        @default(0)    // positive = employee owes back
  // Workflow
  status             TravelStatus @default(DRAFT)
  reviewedById       String?
  reviewedBy         User?        @relation("TravelReviewer", fields: [reviewedById], references: [id])
  reviewNote         String?
  reviewedAt         DateTime?
  itinerary          String?      // free-text or markdown itinerary
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([employeeId, status])
  @@index([projectId])
}

// ── Phase 16: Relationship / Contact Management ───────────────────────────────

enum ContactType {
  DONOR_OFFICER
  PRIME_CONTRACTOR
  PARTNER_ORG
  GOVERNMENT_OFFICIAL
  CONSULTANT_EXTERNAL
  MEDIA
  OTHER
}

model Contact {
  id               String      @id @default(cuid())
  name             String
  organisation     String?
  jobTitle         String?
  contactType      ContactType @default(OTHER)
  email            String?
  phone            String?
  linkedInUrl      String?
  country          String?
  notes            String?
  // Optional links to existing system entities
  donorGrantId     String?
  donorGrant       DonorGrant? @relation(fields: [donorGrantId], references: [id], onDelete: SetNull)
  opportunityId    String?     // linked BD opportunity
  lastContactedAt  DateTime?
  createdById      String
  createdBy        User        @relation("ContactCreator", fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([contactType])
  @@index([donorGrantId])
}

// ── Phase 16: Deliverable Version Control ─────────────────────────────────────

model DeliverableSubmission {
  id            String    @id @default(cuid())
  milestoneId   String
  milestone     Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  version       Int       @default(1)          // increments on each resubmission
  title         String
  description   String?
  fileUrl       String?
  filename      String?
  // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | REVISION_REQUESTED
  status        String    @default("DRAFT")
  submittedById String
  submittedBy   User      @relation("DeliverableSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime?
  reviewedById  String?
  reviewedBy    User?     @relation("DeliverableReviewer", fields: [reviewedById], references: [id])
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([milestoneId, version])
}

// ── ASIL: Astellic Social Impact Lab ─────────────────────────────────────────

enum PilotPhase {
  DESIGN
  IMPLEMENTATION
  EVALUATION
  PUBLISHED
}

enum PilotDomain {
  HEALTH
  ENVIRONMENTAL_SUSTAINABILITY
  GENDER
}

enum EthicsClearance {
  NOT_REQUIRED
  PENDING
  SUBMITTED
  CLEARED
}

enum KnowledgeProductType {
  LEARNING_REPORT
  INTELLIGENCE_BRIEF
  ANNUAL_REVIEW
  PRACTICE_NOTE
  WORKING_PAPER
}

enum KnowledgeProductStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

enum IntelConfidence {
  HIGH
  MEDIUM
  PROVISIONAL
}

enum IntelType {
  ADVISORY_IMPLICATION
  METHODOLOGY_FINDING
  GOVERNANCE_PATTERN
  POLITICAL_ECONOMY
  IMPLEMENTATION_RISK
}

enum IntelTransfer {
  INTERNAL
  TRANSFERRED
  PUBLISHED
}

model PilotProfile {
  id                    String          @id @default(cuid())
  projectId             String          @unique
  project               Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pilotCode             String          @unique
  phase                 PilotPhase      @default(DESIGN)
  domain                PilotDomain
  learningQuestions     String[]        @default([])
  theoryOfChange        String?
  ethicsClearance       EthicsClearance @default(NOT_REQUIRED)
  ethicsClearanceRef    String?
  implementationSites   String[]        @default([])
  methodologyNotes      String?
  dataQualityProtocol   String?
  politicalEconomyNotes String?
  adaptiveManagementLog Json            @default("[]")
  advisoryImplications  String?
  nullResultsNote       String?
  context               String?
  archivedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  knowledgeProducts     KnowledgeProduct[]
  intelligenceEntries   IntelligenceEntry[]
}

model KnowledgeProduct {
  id                   String                 @id @default(cuid())
  pilotId              String?
  pilot                PilotProfile?          @relation(fields: [pilotId], references: [id], onDelete: SetNull)
  title                String
  productType          KnowledgeProductType
  domain               PilotDomain
  description          String?
  advisoryImplications String[]               @default([])
  keyLearnings         String[]               @default([])
  status               KnowledgeProductStatus @default(DRAFT)
  isPublicFacing       Boolean                @default(false)
  publishedAt          DateTime?
  targetAudience       String[]               @default([])
  citationRef          String?
  fileUrl              String?
  filename             String?
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([status])
  @@index([domain])
}

model IntelligenceEntry {
  id             String          @id @default(cuid())
  pilotId        String?
  pilot          PilotProfile?   @relation(fields: [pilotId], references: [id], onDelete: SetNull)
  type           IntelType
  domain         PilotDomain
  content        String
  confidence     IntelConfidence @default(PROVISIONAL)
  geography      String[]        @default([])
  tags           String[]        @default([])
  transferStatus IntelTransfer   @default(INTERNAL)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([domain, type])
  @@index([transferStatus])
}
