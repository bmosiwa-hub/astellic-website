generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IncomeType {
  GRANT
  PRIVATE_SERVICE
  DONATION
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  RESTRUCTURED
  DEFAULTED
}

enum Role {
  CEO
  FINANCE_MANAGER
  STAFF
  CONSULTANT
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              Role               @default(FINANCE_MANAGER)
  active            Boolean            @default(true)
  employeeId        String?            // links to Employee.id for STAFF users
  consultantId      String?            // links to Consultant.id for CONSULTANT users
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs         AuditLog[]
  requestedChanges  PendingChange[]    @relation("RequestedChanges")
  approvedChanges   PendingChange[]    @relation("ApprovedChanges")
  submissions       Submission[]       @relation("SubmittedBy")
  submissionReviews SubmissionReview[] @relation("ReviewedBy")
  liquidations      Liquidation[]      @relation("LiquidationBy")
  recurringExpenses RecurringExpense[]
  accountPayables   AccountPayable[]   @relation("APCreatedBy")
  accountReceivables AccountReceivable[] @relation("ARCreatedBy")
}

model Project {
  id                 String              @id @default(cuid())
  name               String
  client             String
  description        String?
  status             ProjectStatus       @default(ACTIVE)
  startDate          DateTime
  endDate            DateTime?
  budget             Float?
  currency           String              @default("MWK")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  income             Income[]
  expenses           Expense[]
  consultantPayments ConsultantPayment[]
  submissions        Submission[]
  receivables        AccountReceivable[]
}

model Income {
  id            String      @id @default(cuid())
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id])
  incomeType    IncomeType  @default(GRANT)
  description   String
  amount        Float
  currency      String      @default("MWK")
  receivedDate  DateTime
  source        String?
  invoiceNumber String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  description String
  amount      Float
  currency    String   @default("MWK")
  category    String
  paidDate    DateTime
  vendor      String?
  receiptRef  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Consultant {
  id             String              @id @default(cuid())
  name           String
  email          String?
  phone          String?
  specialisation String?
  dailyRate      Float?
  currency       String              @default("MWK")
  taxPin         String?
  active         Boolean             @default(true)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  payments       ConsultantPayment[]
}

model ConsultantPayment {
  id             String        @id @default(cuid())
  consultantId   String
  consultant     Consultant    @relation(fields: [consultantId], references: [id])
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id])
  description    String
  daysWorked     Float?
  rateUsed       Float?
  grossAmount    Float
  withholdingTax Float         @default(0)
  netAmount      Float
  currency       String        @default("MWK")
  paidDate       DateTime?
  status         PaymentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Employee {
  id          String    @id @default(cuid())
  name        String
  email       String?
  position    String
  department  String?
  grossSalary Float
  currency    String    @default("MWK")
  taxPin      String?
  nssf        String?
  startDate   DateTime
  endDate     DateTime?
  active      Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payrolls    Payroll[]
}

model Payroll {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  period          String
  grossSalary     Float
  paye            Float         @default(0)
  nssfEmployee    Float         @default(0)
  nssfEmployer    Float         @default(0)
  otherDeductions Float         @default(0)
  netPay          Float
  currency        String        @default("MWK")
  paidDate        DateTime?
  status          PaymentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Debt {
  id            String          @id @default(cuid())
  lender        String
  description   String
  principal     Float
  currency      String          @default("MWK")
  interestRate  Float?
  disbursedDate DateTime
  dueDate       DateTime?
  status        DebtStatus      @default(ACTIVE)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  repayments    DebtRepayment[]
}

model DebtRepayment {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id])
  amount    Float
  currency  String   @default("MWK")
  paidDate  DateTime
  notes     String?
  createdAt DateTime @default(now())
}

model TaxConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Float
  label     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

enum ChangeType {
  EDIT
  DELETE
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model PendingChange {
  id          String       @id @default(cuid())
  entity      String       // "Income" | "Expense"
  entityId    String
  changeType  ChangeType
  status      ChangeStatus @default(PENDING)
  requestedBy String
  requester   User         @relation("RequestedChanges", fields: [requestedBy], references: [id])
  approvedBy  String?
  approver    User?        @relation("ApprovedChanges", fields: [approvedBy], references: [id])
  snapshot    Json         // original record at time of request
  proposed    Json?        // new values for EDIT (null for DELETE)
  reason      String?
  reviewNote  String?
  createdAt   DateTime     @default(now())
  reviewedAt  DateTime?
}

// ── Submission (Invoice / Request) ──────────────────────────────

enum SubmissionType {
  INVOICE
  REQUEST
}

enum SubmissionStatus {
  PENDING_FM
  FM_CHANGES_REQUESTED
  PENDING_CEO
  CEO_CHANGES_REQUESTED
  APPROVED    // CEO approved — FM to process payment
  PAID
  REJECTED
}

enum ReviewAction {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

model Submission {
  id           String           @id @default(cuid())
  submittedBy  String
  submitter    User             @relation("SubmittedBy", fields: [submittedBy], references: [id])
  type         SubmissionType
  status       SubmissionStatus @default(PENDING_FM)

  // Invoice-specific
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id])
  milestone    String?

  // Request-specific
  purpose      String?
  requestDate  DateTime?
  activityDate DateTime?
  budgetLine   String?          // "ADMIN" or project name

  // Common
  currency     String           @default("MWK")
  totalAmount  Float            @default(0)
  notes        String?

  lineItems    SubmissionItem[]
  reviews      SubmissionReview[]
  liquidations Liquidation[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model SubmissionItem {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  item         String
  description  String?
  activityDate DateTime?
  amount       Float
  createdAt    DateTime   @default(now())
}

model SubmissionReview {
  id           String       @id @default(cuid())
  submissionId String
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewedBy   String
  reviewer     User         @relation("ReviewedBy", fields: [reviewedBy], references: [id])
  reviewerRole String       // "FM" | "CEO"
  action       ReviewAction
  note         String?
  createdAt    DateTime     @default(now())
}

// ── Liquidation ─────────────────────────────────────────────────

enum LiquidationStatus {
  PENDING_FM
  CHANGES_REQUESTED
  FM_APPROVED
  FM_REJECTED
}

enum DocType {
  RECEIPT
  REFUND_PROOF
  OVER_EXPENDITURE_PROOF
  PRIOR_APPROVAL_PROOF
}

model Liquidation {
  id                String            @id @default(cuid())
  submissionId      String
  submission        Submission        @relation(fields: [submissionId], references: [id])
  submittedBy       String
  submitter         User              @relation("LiquidationBy", fields: [submittedBy], references: [id])

  liquidationDate   DateTime
  activity          String
  budgetLine        String
  fundsReceived     Float
  fundsAccountedFor Float
  refundRequired    Float             // positive = owes back; negative = overspent
  currency          String            @default("MWK")

  status            LiquidationStatus @default(PENDING_FM)
  fmNote            String?
  reviewedByName    String?
  reviewedAt        DateTime?

  documents         LiquidationDocument[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model LiquidationDocument {
  id            String      @id @default(cuid())
  liquidationId String
  liquidation   Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  docType       DocType
  url           String
  filename      String
  uploadedAt    DateTime    @default(now())
}

// ── Recurring Expenses & AP/AR ───────────────────────────────────

enum RecurringFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum PayableStatus {
  UPCOMING
  DUE
  PAID
  OVERDUE
  CANCELLED
}

enum ReceivableStatus {
  EXPECTED
  RECEIVED
  PARTIAL
  OVERDUE
  CANCELLED
}

model RecurringExpense {
  id          String             @id @default(cuid())
  name        String
  description String?
  amount      Float
  currency    String             @default("MWK")
  category    String?
  budgetLine  String?
  vendor      String?
  frequency   RecurringFrequency
  startDate   DateTime
  endDate     DateTime?
  active      Boolean            @default(true)
  createdBy   String
  creator     User               @relation(fields: [createdBy], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  payables    AccountPayable[]
}

model AccountPayable {
  id                 String            @id @default(cuid())
  description        String
  vendor             String?
  amount             Float
  currency           String            @default("MWK")
  dueDate            DateTime
  paidDate           DateTime?
  status             PayableStatus     @default(UPCOMING)
  note               String?
  budgetLine         String?
  reminderSent       Boolean           @default(false)
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  createdBy          String
  creator            User              @relation("APCreatedBy", fields: [createdBy], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model AccountReceivable {
  id           String           @id @default(cuid())
  description  String
  payer        String?
  amount       Float
  currency     String           @default("MWK")
  expectedDate DateTime
  receivedDate DateTime?
  status       ReceivableStatus @default(EXPECTED)
  note         String?
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id])
  createdBy    String
  creator      User             @relation("ARCreatedBy", fields: [createdBy], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}
