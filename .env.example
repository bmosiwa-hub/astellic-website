# Microsoft 365 SMTP credentials (GoDaddy / Office 365)
# SMTP host: smtp.office365.com | Port: 587 | STARTTLS
# Use the primary mailbox (not an alias) — aliases cannot authenticate
SMTP_USER=admin@astellic.com
SMTP_PASS=your-microsoft-365-password

# Recipient email for roster applications (kept server-side only)
RECIPIENT_EMAIL=admin@astellic.com

# Recipient email for partnership proposals
PARTNERSHIP_EMAIL=admin@astellic.org

# ── Financial Management System ───────────────────────────────────────────────
# PostgreSQL connection string (Vercel Postgres / Neon)
DATABASE_URL=postgresql://user:password@host:5432/astellic_finance?sslmode=require

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Public URL of the site (required by NextAuth)
NEXTAUTH_URL=https://astellic.com

# Cron job secret — generate with: openssl rand -base64 32
# Add to Vercel env vars; Vercel sets this automatically on Pro plans
CRON_SECRET=your-cron-secret-here

# Email address to receive weekly backup (defaults to SMTP_USER if blank)
BACKUP_EMAIL=admin@astellic.com
