# Microsoft 365 SMTP credentials (GoDaddy / Office 365)
# SMTP host: smtp.office365.com | Port: 587 | STARTTLS
# Use the primary mailbox (not an alias) — aliases cannot authenticate
SMTP_USER=admin@astellic.com
SMTP_PASS=your-microsoft-365-password

# Recipient email for roster applications (kept server-side only)
# Can be an alias — emails are delivered here
RECIPIENT_EMAIL=hr@astellic.com

# Recipient email for partnership proposals
PARTNERSHIP_EMAIL=admin@astellic.org
