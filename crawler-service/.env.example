# Astellic Crawler Service — Environment Variables
# Set these in Railway's environment variable panel

# Neon PostgreSQL connection string (same DB as the main IMS)
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Base URL of your deployed IMS (no trailing slash)
IMS_BASE_URL=https://your-domain.vercel.app

# Shared secret — must match INTEL_API_KEY in the IMS environment
INTEL_API_KEY=your-secret-key-here

# Optional: override health check port
PORT=3001
